@import url('https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap');
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#05060d;color:#f5f7ff;font-family:"Prompt","Kanit",sans-serif;min-height:100vh}
body:before{content:"";position:fixed;inset:0;pointer-events:none;background:radial-gradient(circle at 15% 5%,#2458ff22,transparent 30%),radial-gradient(circle at 90% 80%,#c126ff1c,transparent 35%)}
a{text-decoration:none;color:inherit}button,input{font:inherit}.top{position:sticky;top:14px;z-index:20;width:min(1120px,94%);height:76px;margin:14px auto;padding:10px 16px;border:1px solid #ffffff18;border-radius:22px;background:#0b0e18dd;backdrop-filter:blur(18px);display:flex;align-items:center;justify-content:space-between;box-shadow:0 18px 55px #0008}
.brand img{width:150px;height:50px}.actions{display:flex;gap:9px}.actions button{width:45px;height:45px;display:grid;place-items:center;border:1px solid #ffffff18;border-radius:14px;background:#111522;color:#dfe6ff;cursor:pointer;transition:.2s}.actions button:hover{transform:translateY(-2px);border-color:#6be9ff77;box-shadow:0 0 22px #36d9ff22}
#menu{display:none;position:fixed;right:3%;top:103px;z-index:30;min-width:190px;padding:9px;border:1px solid #ffffff1c;border-radius:18px;background:#090c16f2;backdrop-filter:blur(18px);box-shadow:0 20px 60px #0009}#menu.show{display:grid}#menu a{padding:12px 15px;border-radius:12px;color:#dce3ff}#menu a:hover{background:#ffffff0b}
main{width:min(1120px,94%);margin:35px auto}.hero,.panel{border:1px solid #ffffff14;border-radius:28px;background:#0b0e18cc;backdrop-filter:blur(15px);box-shadow:0 20px 70px #0008}.hero{min-height:310px;padding:40px;display:grid;place-content:center;text-align:center;overflow:hidden}.hero h1{font-size:clamp(38px,8vw,76px);line-height:1.05;margin:8px 0;font-weight:700}.hero h1 span{background:linear-gradient(90deg,#5ce8ff,#b35cff);-webkit-background-clip:text;color:transparent}.hero p{color:#9da7c5}
h2{font-size:30px;margin:0 0 22px}.panel{padding:30px;margin-bottom:30px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px}.card{position:relative;border-radius:23px;padding:1px;overflow:hidden;background:#111626;isolation:isolate}.card:before{content:"";position:absolute;inset:-120%;z-index:-1;background:conic-gradient(from 0deg,transparent 0 25%,#55eaff 35%,#b45cff 50%,transparent 60%);animation:spin 4s linear infinite}.card:after{content:"";position:absolute;inset:1px;z-index:-1;background:#0c101c;border-radius:22px}.pic{height:205px;border-radius:22px 22px 0 0;overflow:hidden;background:#11162a}.pic img{width:100%;height:100%;object-fit:cover}.info{padding:17px;display:grid;gap:8px}.info h3{margin:0;font-size:19px}.info strong{font-size:21px}.info small{color:#8f9ab8}.buy{display:block;text-align:center;margin-top:4px;padding:12px;border-radius:13px;background:linear-gradient(100deg,#176dff,#9b38e8);box-shadow:0 0 22px #704cff2c;transition:.2s}.buy:hover{transform:translateY(-2px);box-shadow:0 0 30px #7a5cff55}.panel button{padding:12px 16px;border:1px solid #ffffff16;border-radius:13px;background:#121726;color:#eef;cursor:pointer}.auth{max-width:440px;margin:10vh auto;display:grid;gap:13px;text-align:center}.auth input,.confirm input{width:100%;padding:13px;border:1px solid #ffffff18;border-radius:13px;background:#080b13;color:#fff;outline:none}.auth input:focus,.confirm input:focus{border-color:#5ce8ff88}.auth-logo{width:110px;margin:auto}.admin-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px}
#loader{position:fixed;inset:0;z-index:100;background:#03040a;display:grid;place-content:center;justify-items:center;gap:18px;transition:.55s}.loader-logo{position:relative;width:145px;height:145px;display:grid;place-items:center}.loader-logo img{width:105px;z-index:2}.ring{position:absolute;inset:0;border:3px solid transparent;border-top-color:#5ce8ff;border-right-color:#b45cff;border-radius:50%;animation:spin 1s linear infinite;box-shadow:0 0 35px #54ddff44}.hide{opacity:0;pointer-events:none}@keyframes spin{to{transform:rotate(360deg)}}@media(max-width:600px){.top{height:68px}.brand img{width:125px}.actions button{width:41px;height:41px}.hero{min-height:270px;padding:25px}.panel{padding:22px}}
